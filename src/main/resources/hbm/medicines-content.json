  "sourceSemantics": {
    "pills": "10 ticks; nutrition 0, saturation modifier0.6, always edible; original negative-effect lists and disease reductions; original 1/25 chocolate overdose; exact digamma helpers",
    "radaway": "The actually bound ItemSimpleConsumable implementation:140/350/500 ticks, one RAD removed per tick, additive duration, iv_empty returned; no old unbound ItemSyringe branch",
    "sickness": "PotionConfig default OFF; NORMAL seconds, TERRARIA times12; empty cure set; herbal unconditionally adds12000 ticks",
    "metalSyringes": "Immediate self-use or attack injection, actual original effects and returns; the source final-stack self-use return precedes applying potion sickness, while attack always applies sickness",
    "redPill": "3600 second death effect is a player model replacement, not periodic damage; original player_fem OBJ, original per-part pivots and rotations, original flat HFR UVs/normals",
    "anvilPoisonedFood": "Original ntmCyanide / ntmRedPill custom-data flags execute on player food completion, using the pre-consumption stack; ten randomized1000HP euthanasia hits or ten applications of3600-second player-model effect, respectively.",
    "mku": "216000 tick timer, armor/item contamination, aerial spread range2 or16 in water/rain, original symptom thresholds and damage doubling; original unreachable end-of-timer lethal branch remains unreachable",
    "experienceBags": "Original EnchantmentUtil experience curve,100 points transferred, real player restriction for collection",
    "armorMedicine": "Original serum replaces poison with5-second StrengthV; auto5HTP consumes the chest attachment at digamma>=5, removes5digamma, grants60-second stability and20HP; knife removes2maximumHP every50ticks down to2, permanent modifier and original client properJolt.",
    "smoking": "Original30-tick BOW use; cigarette adds2000each lung disease and100RAD, crackpipe adds500blacklung/heals10HP/10-second nausea; source smoke tiles and exact puff count/velocity/lifetime.",
    "effects": "Six remaining HbmPotion registry names, exact colors/readiness/tick actions, original18px sprites cropped without redraw; five existing ExposureEffects identities reused"
  },
  "limitations": [
    "Taint terrain trails are default OFF as in source and can only target the actual taint block once its block module is present.",
    "Full recipe availability follows real ingredient migration; the central recipe generators are managed by the parent agent."
  ],
  "runtimeValidated": false
